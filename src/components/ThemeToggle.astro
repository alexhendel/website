---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label={label}
  title={label}
  class="pixel-button"
>
  <!-- 16×16 pixel icons, drawn at 2× so every pixel stays square -->
  <svg class="icon icon-moon" viewBox="0 0 16 16" width="32" height="32" shape-rendering="crispEdges" aria-hidden="true">
    <path
      fill="currentColor"
      d="M6 1h6v1h-6z M4 2h7v1h-7z M3 3h4v1h-4z M2 4h3v8h-3z M3 12h4v1h-4z M4 13h7v1h-7z M6 14h6v1h-6z"></path>
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 16 16" width="32" height="32" shape-rendering="crispEdges" aria-hidden="true">
    <path
      fill="currentColor"
      d="M6 4h4v1h1v1h1v4h-1v1h-1v1h-4v-1h-1v-1h-1v-4h1v-1h1z M7 0h2v2h-2z M7 14h2v2h-2z M0 7h2v2h-2z M14 7h2v2h-2z M2 2h2v2h-2z M12 2h2v2h-2z M2 12h2v2h-2z M12 12h2v2h-2z"
    ></path>
  </svg>
</button>

<style>
  .icon-sun,
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .icon-sun {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pop .icon {
      animation: pixel-pop 320ms steps(4) both;
    }
  }
  @keyframes pixel-pop {
    from {
      transform: rotate(-90deg) scale(0.25);
    }
    to {
      transform: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const sync = () => btn.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
    sync();
    btn.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      sync();
      // Restart the pop animation on every click.
      btn.classList.remove("pop");
      void btn.offsetWidth;
      btn.classList.add("pop");
    });
  }
</script>
